# ==============================================================================
# Thales SafeNet Trusted Access (STA) Granular API Proxy Environment Config
# ==============================================================================

# Port to bind the API Proxy Gateway
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Upstream Thales SafeNet Trusted Access (STA) Settings
# ------------------------------------------------------------------------------
# STA_BASE_URL: The base REST API URL for your Thales STA tenant datacenter.
# Examples: https://api.safenetid.com (EU), https://api.us.safenetid.com (US)
STA_BASE_URL="https://api.safenetid.com"

# STA_TENANT_ID: Your SafeNet Trusted Access tenant code/ID
STA_TENANT_ID="STA-ENTERPRISE-TENANT-EU"

# STA_MASTER_API_KEY: The tenant-wide administrator API Key generated in Thales STA console
# This secret is kept isolated within the proxy and never returned to external callers.
STA_MASTER_API_KEY="sta_master_secret_live_992184a7c134bf"

# ------------------------------------------------------------------------------
# OpenID Connect (OIDC) JWT Verification
# ------------------------------------------------------------------------------
# OIDC_ISSUER: The corporate Identity Provider issuer URL (Okta, Keycloak, Ping, Entra ID)
OIDC_ISSUER="https://auth.enterprise-corp.com/oauth2/v1"

# OIDC_AUDIENCE: The expected audience claim for the API proxy
OIDC_AUDIENCE="https://api-proxy.enterprise-corp.com/sta"

# OIDC_ROLE_CLAIM: The JSON claim holding caller roles (e.g. roles, groups, realm_access.roles)
OIDC_ROLE_CLAIM="roles"

# ------------------------------------------------------------------------------
# SIEM & Syslog Real-Time Log Forwarding
# ------------------------------------------------------------------------------
# SIEM_FORWARDING_ENABLED: Enable real-time forwarding of all audit records (true/false)
SIEM_FORWARDING_ENABLED="false"

# SIEM_PROTOCOL: Transport protocol: UDP | TCP | TLS | SPLUNK_HEC | WEBHOOK
SIEM_PROTOCOL="UDP"

# SIEM_HOST: Hostname or IP of the SIEM collector or Syslog daemon (e.g. syslog.corp.internal, 10.0.1.50)
SIEM_HOST="syslog.corp.internal"

# SIEM_PORT: Target collector port (default Syslog UDP/TCP: 514, TLS: 6514, Splunk HEC: 8088)
SIEM_PORT="514"

# SIEM_FORMAT: Wire payload standard: RFC_5424 | RFC_3164 | CEF | JSON
# RFC_5424 includes structured data [staAudit@44917 ...]
# CEF is optimized for Micro Focus ArcSight & IBM QRadar
SIEM_FORMAT="RFC_5424"

# SIEM_FACILITY: Syslog facility code (default: 16 = local0, 4 = auth, 10 = authpriv)
SIEM_FACILITY="16"

# SIEM_APP_NAME: Syslog APP-NAME header (default: thales-sta-proxy)
SIEM_APP_NAME="thales-sta-proxy"

# SIEM_HEC_TOKEN: Splunk HTTP Event Collector authentication token (for SPLUNK_HEC protocol)
SIEM_HEC_TOKEN="00000000-0000-0000-0000-000000000000"

# SIEM_WEBHOOK_URL: Destination endpoint for WEBHOOK protocol (e.g. HTTPS SIEM collector)
SIEM_WEBHOOK_URL="https://siem-collector.corp.internal/v1/audit"

# ------------------------------------------------------------------------------
# Standard Platform Environment Variables
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

