# ==============================================================================
# Thales SafeNet Trusted Access (STA) Granular API Proxy Environment Config
# ==============================================================================

# Port to bind the API Proxy Gateway
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Upstream Thales SafeNet Trusted Access (STA) Settings
# ------------------------------------------------------------------------------
# STA_BASE_URL: The base REST API URL for your Thales STA tenant datacenter.
# Examples: https://api.safenetid.com (EU), https://api.us.safenetid.com (US)
STA_BASE_URL="https://api.safenetid.com"

# STA_TENANT_ID: Your SafeNet Trusted Access tenant code/ID
STA_TENANT_ID="STA-ENTERPRISE-TENANT-EU"

# STA_MASTER_API_KEY: The tenant-wide administrator API Key generated in Thales STA console
# This secret is kept isolated within the proxy and never returned to external callers.
STA_MASTER_API_KEY="sta_master_secret_live_992184a7c134bf"

# ------------------------------------------------------------------------------
# OpenID Connect (OIDC) JWT Verification
# ------------------------------------------------------------------------------
# OIDC_ISSUER: The corporate Identity Provider issuer URL (Okta, Keycloak, Ping, Entra ID)
OIDC_ISSUER="https://auth.enterprise-corp.com/oauth2/v1"

# OIDC_AUDIENCE: The expected audience claim for the API proxy
OIDC_AUDIENCE="https://api-proxy.enterprise-corp.com/sta"

# OIDC_ROLE_CLAIM: The JSON claim holding caller roles (e.g. roles, groups, realm_access.roles)
OIDC_ROLE_CLAIM="roles"

# ------------------------------------------------------------------------------
# Standard Platform Environment Variables
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
